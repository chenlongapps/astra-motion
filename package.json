{
  "name": "astra-motion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs --preview",
    "generate:audio": "node scripts/generate-audio.mjs",
    "render": "node scripts/render.mjs",
    "render:1080p": "node scripts/render.mjs --resolution=1080p",
    "render:4k": "node scripts/render.mjs --resolution=4k",
    "render:samples": "node scripts/render.mjs --samples",
    "render:frames": "node scripts/render.mjs --keep-frames",
    "render:from-frames": "node scripts/render.mjs --from-frames",
    "test": "node --test scripts/*.test.mjs",
    "test:render": "node --test scripts/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:frames": "node scripts/verify-frames.mjs",
    "verify:video": "node scripts/verify-video.mjs",
    "verify:audio": "node scripts/verify-audio.mjs"
  }
}
